// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String        @id @default(uuid())
  email              String        @unique
  password           String
  name               String
  age                Int?
  bio                String?
  image              String?
  photos             UserPhoto[]
  interests          String[]      @default([])
  rpgClass           String?
  favoriteGames      String[]      @default([])
  favoriteAnimes     String[]      @default([])
  favoriteConsoles   String[]      @default([])
  favoriteGeekCategories String[]  @default([])
  latitude           Float?
  longitude          Float?
  locationName       String?
  isTravelMode       Boolean       @default(false)
  travelLocationName String?
  travelLatitude     Float?
  travelLongitude    Float?
  musicGenres        String[]      @default([])
  favoriteBands      String[]      @default([])
  spotifyUrl         String?
  steamId            String?
  instagramHandle    String?
  twitterHandle      String?
  tiktokHandle       String?
  facebookUrl        String?
  showSocials        Boolean       @default(true)
  isOnline           Boolean       @default(false)
  lastSeen           DateTime      @default(now())
  pushToken          String?       @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  interactions       Interaction[] @relation("user")
  interactionsTarget Interaction[] @relation("targetUser")
  matches            Match[]       @relation("matches")
  sentMessages       Message[]     @relation("sender")
  blockedUsers       Block[]       @relation("blocker")
  blockedBy          Block[]       @relation("blocked")
  reportsSent        Report[]      @relation("reporter")
  reportsReceived    Report[]      @relation("reported")
}

model UserPhoto {
  id        String   @id @default(uuid())
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model Interaction {
  id           String   @id @default(uuid())
  liked        Boolean
  isSuperLike  Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation("user", fields: [userId], references: [id])
  userId       String
  targetUser   User     @relation("targetUser", fields: [targetUserId], references: [id])
  targetUserId String

  @@unique([userId, targetUserId])
}

model Match {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  users     User[]    @relation("matches")
  messages  Message[]
}

model Message {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  text      String
  imageUrl  String?
  audioUrl  String?
  isRead    Boolean  @default(false)
  sender    User     @relation("sender", fields: [senderId], references: [id])
  senderId  String
  match     Match    @relation(fields: [matchId], references: [id])
  matchId   String
}

model Block {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  blocker   User     @relation("blocker", fields: [blockerId], references: [id])
  blockerId String
  blocked   User     @relation("blocked", fields: [blockedId], references: [id])
  blockedId String

  @@unique([blockerId, blockedId])
}

model Report {
  id         String   @id @default(uuid())
  reason     String
  details    String?
  createdAt  DateTime @default(now())
  reporter   User     @relation("reporter", fields: [reporterId], references: [id])
  reporterId String
  reported   User     @relation("reported", fields: [reportedId], references: [id])
  reportedId String
}


